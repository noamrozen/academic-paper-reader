# Set at least one provider key. OpenRouter gives access to models from every provider with one key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Provider selected by default (anthropic, openai, gemini, openrouter) when it has a key.
DEFAULT_PROVIDER=openrouter

# Optional: a Turso database (hosted SQLite) instead of data/app.db. Needed on Vercel, where the
# app can't keep files; see "Deploying to Vercel" in the README.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Optional: better web search than the default (DuckDuckGo, no key needed).
TAVILY_API_KEY=

# Optional overrides for the default model shown for each provider.
# ANTHROPIC_DEFAULT_MODEL=claude-opus-5
# OPENAI_DEFAULT_MODEL=gpt-5
# GEMINI_DEFAULT_MODEL=gemini-3.8-flash
# OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash

# Prompt-cache TTL for the paper prefix on Claude: "5m" or "1h".
# 1h costs more to write but survives longer gaps between sessions on the same paper.
# CLAUDE_PAPER_CACHE_TTL=1h

# Optional spending budgets in USD, shown in the Usage panel (week starts on Monday). An OpenRouter
# key's own credit limit, if it has one, is shown there too.
# BUDGET_DAILY=2
# BUDGET_WEEKLY=10
# BUDGET_MONTHLY=30

# OpenRouter reserves credit for the full output limit before each call; lower this on a small balance.
# OPENROUTER_MAX_TOKENS=16384

# Voice questions (the mic button) are transcribed by speech-to-text models on OpenRouter (needs
# OPENROUTER_API_KEY). TRANSCRIBE_MODEL gives each phrase its final text once you pause;
# TRANSCRIBE_DRAFT_MODEL drafts the phrase still being spoken. Any model listed by
# https://openrouter.ai/api/v1/models?output_modalities=transcription works, but only Whisper is
# primed with the paper's terms. Set TRANSCRIBE_LANGUAGE= (empty) to detect the spoken language.
# TRANSCRIBE_MODEL=openai/whisper-large-v3
# TRANSCRIBE_DRAFT_MODEL=openai/whisper-large-v3-turbo
# TRANSCRIBE_LANGUAGE=en
# Seconds of silence after you stop talking before the recording stops by itself.
# VOICE_END_SILENCE=1.5
